// The class of a byte for the signed context mode: 0, 1, 2, 3, 4, 5, 6
// or 7 by the byte's size as a signed quantity.
fn signed_class(v: Int) -> Int
    if v == 0
        0
    elif v < 16
        1
    elif v < 64
        2
    elif v < 128
        3
    elif v < 192
        4
    elif v < 240
        5
    elif v < 255
        6
    else
        7

// How many contexts a literal block type has: 64.
pub fn literal_context_count() -> Int []
    64

// How many contexts a distance block type has: 4.
//
// Four rather than 64, because the distance context is the copy
// length clamped — a short copy and a long one want different
// distance distributions, and nothing finer helps.
pub fn distance_context_count() -> Int []
    4

// The mode a number names.
//
// `BroBadContextMap` outside 0 to 3.
pub fn mode_of(code: Int) -> Result<BroContextMode, brotlierror.BroFault> []
    match code
        0 => Ok(BroLsb6)
        1 => Ok(BroMsb6)
        2 => Ok(BroUtf8)
        3 => Ok(BroSigned)
        _ => Err(BroBadContextMap(0, code))

// The context the two previous bytes give under a mode.
//
// `p1` is the byte immediately before the one being decoded and `p2`
// the one before that; both are 0 at the start of a meta-block, which
// is from the specification and not a convenience — a decoder that
// carried them across meta-blocks decodes the first literals of every
// block but the first with the wrong code.
//
// ```novo
// use brotlicontext
//
// fn main() [io]
//     println("${brotlicontext.literal_context(BroLsb6, 65, 0)}")
// ```
pub fn literal_context(mode: BroContextMode, p1: Int, p2: Int) -> Int []
    match mode
        BroLsb6   => p1 & 63
        BroMsb6   => p1 >> 2
        BroUtf8   => LUT0[p1 & 255] | LUT1[p2 & 255]
        BroSigned => signed_class(p1 & 255) * 8 + signed_class(p2 & 255)

// The distance context a copy length gives.
//
// `copy - 2` clamped to 0 to 3, which is the whole rule — published
// because it reads as arbitrary and because a caller that guessed
// `copy` or `copy - 1` would be wrong on every short copy.
pub fn distance_context(copy_length: Int) -> Int []
    if copy_length > 4
        3
    elif copy_length < 2
        0
    else
        copy_length - 2

// ── The map ──────────────────────────────────────────────────────────

// Read a context map.
//
// `size` is the number of entries the map must have — the block-type
// count times the context count for its category — and a map that
// decodes to a different number of entries is `BroBadContextMap`
// carrying both.
//
// The inverse move-to-front pass is applied when the stream's flag
// says so, inside this call, because a caller that had to remember it
// would get a map that is a permutation of the right one and produces
// plausible bytes with no error anywhere.
pub fn read_map(src: Bytes, at_bit: Int, size: Int,
                tree_count: Int) -> Result<BroContextMap, brotlierror.BroFault> []
    var r = brotlistream.reader(src, at_bit)
    read_map_from(var r, size, tree_count)

// How many BITS the map occupied.
pub fn map_bits(m: BroContextMap) -> Int []
    m.bits

// The prefix-code index for a block type and a context.
//
// `block_type * context_count + context`, bounds-checked.  The
// arithmetic is one line and is here rather than at the call site
// because the two factors are easy to write in the wrong order and
// the result is a valid index into a valid map.
pub fn tree_for(m: BroContextMap, block_type: Int, context: Int, context_count: Int) -> Int []
    let i = block_type * context_count + context
    if i < 0 or i >= list.len(m.tree_of)
        0
    else
        m.tree_of[i]

// How many entries the map holds.
pub fn map_size(m: BroContextMap) -> Int []
    list.len(m.tree_of)

// Whether every entry is inside the tree count.
//
// The check `read_map` makes, published so a caller validating a
// stream it received can make it without re-reading.
pub fn map_is_sound(m: BroContextMap) -> Bool []
    var ok = true
    for t in m.tree_of
        if t < 0 or t >= m.tree_count
            ok = false
    ok

// The identity map: every context on tree 0.
//
// What a meta-block with one literal tree has, and what an encoder at
// quality 0 emits.  Published so a decoder has one value for the case
// where no map was written at all, rather than a `?BroContextMap` that
// every call site has to unwrap.
pub fn identity_map(size: Int) -> BroContextMap []
    BroContextMap { tree_of: list.zeros(size), tree_count: 1, used_mtf: false, bits: 0 }

// The inverse move-to-front transform over a byte list.
//
// Published on its own because it is the one piece of this module a
// test can check against a hand-worked example, and because an encoder
// needs the forward direction of the same table.
pub fn inverse_mtf(v: [Int]) -> [Int] []
    var order = list.range(0, 256)
    var out = [] as [Int]
    for x in v
        let idx = if x < 0
            0
        elif x > 255
            255
        else
            x
        let value = order[idx]
        out = list.push(out, value)
        var k = idx
        while k > 0
            order[k] = order[k - 1]
            k = k - 1
        order[0] = value
    out

// ── Reading a map from a reader ──────────────────────────────────────

// A context map read from the cursor, which is left just after it.
//
// RFC 7932 section 7.3: an optional run-length maximum, a prefix code
// over the tree indices and the run lengths, the entries, and a last
// bit that says whether the inverse move-to-front pass applies.
//
// ```novo
// use std.bytes
// use brotlicontext
// use brotlistream
//
// fn main() [io]
//     var r = brotlistream.reader(bytes.from_byte_list([0, 0, 0, 0]), 0)
//     match brotlicontext.read_map_from(var r, 4, 2)
//         Ok(m) => println("${brotlicontext.map_size(m)}")
//         Err(_) => println("refused")
// ```
pub fn read_map_from(var r: BroReader, size: Int,
                     tree_count: Int) -> Result<BroContextMap, BroFault> []
    let start = r.pos
    let rle_max = if brotlistream.read_bits(var r, 1) == 1
        brotlistream.read_bits(var r, 4) + 1
    else
        0
    match brotliprefix.read_code(var r, tree_count + rle_max)
        Err(e) => Err(e)
        Ok(p)  => read_entries(var r, size, tree_count, rle_max, brotliprefix.table_of(p), start)

// The entries of a map, with the prefix code that spells them.
fn read_entries(var r: BroReader, size: Int, tree_count: Int, rle_max: Int, t: BroTable,
                start: Int) -> Result<BroContextMap, BroFault>
    var map = list.zeros(size)
    var i = 0
    var bad = false
    while i < size and not r.over and not bad
        let sym = brotliprefix.decode_with(t, var r)
        if sym == 0
            i = i + 1
        elif sym <= rle_max
            let run = (1 << sym) + brotlistream.read_bits(var r, sym)
            if i + run > size
                bad = true
            else
                i = i + run
        else
            map[i] = sym - rle_max
            i = i + 1
    let mtf = brotlistream.read_bits(var r, 1) == 1
    if r.over
        Err(BroTruncated(r.pos / 8, 1))
    elif bad
        Err(BroBadContextMap(start / 8, size))
    else
        Ok(BroContextMap { tree_of: (if mtf then inverse_mtf(map) else map), tree_count: tree_count,
                           used_mtf: mtf, bits: r.pos - start })
