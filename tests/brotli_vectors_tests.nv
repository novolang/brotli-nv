// brotli_vectors_tests.nv — streams written by the reference compressor
// (libbrotli through its C interface), decoded back into the bytes that
// went in.
//
// Every input is regenerated here by a small deterministic function, so
// the suite carries the compressed stream and not the text: `gen_text`
// strings sixteen words together with a linear congruential generator,
// `gen_mixed` replaces every fifth word with eight pseudo-random bytes so
// that the compressor has two kinds of content to tell apart, and
// `gen_random` is bytes that do not compress.  The same functions in
// Python made the streams.
//
// What each stream is there to exercise:
//
//   text_q5, text_q11, text_q1, text_q0   the four shapes of command the
//                                         qualities produce, with context
//                                         maps and several literal trees
//   mixed_q11                             block types and block switching
//   random_q5                             a stored meta-block
//   html_q11                              static dictionary references, with
//                                         transforms
//   stream_pieces                         metadata meta-blocks (the empty
//                                         ones a flush writes) between
//                                         compressed ones
//   small_window                          a 1008-byte window, so distances
//                                         past it are dictionary words
//   empty                                 the one-byte stream

use std.bytes
use std.list
use std.test
use brotlidec
use brotlierror
use brotlistream

const WORDS: [Str] = ["the",
    "brotli",
    "stream",
    "of",
    "compressed",
    "bytes",
    "<div>",
    "</div>",
    "window",
    "dictionary",
    "literal",
    "insert",
    "copy",
    "distance",
    "prefix",
    "code"]

fn step_lcg(x: Int) -> Int
    (x * 1103515245 + 12345) & 2147483647

fn gen_text(n: Int, seed: Int) -> Bytes
    var x = seed
    var parts = [] as [Bytes]
    var total = 0
    while total < n
        x = step_lcg(x)
        var w = bytes.from_str(WORDS[(x >> 16) & 15] + " ")
        parts = list.push(parts, w)
        total = total + bytes.len(w)
    bytes.slice(bytes.concat(parts), 0, n)

fn gen_mixed(n: Int, seed: Int) -> Bytes
    var x = seed
    var i = 0
    var parts = [] as [Bytes]
    var total = 0
    while total < n
        x = step_lcg(x)
        i = i + 1
        if i % 5 == 0
            var chunk = [] as [Int]
            for _ in 0..8
                x = step_lcg(x)
                chunk = list.push(chunk, (x >> 16) & 255)
            parts = list.push(parts, bytes.from_byte_list(chunk))
            total = total + 8
        else
            var w = bytes.from_str(WORDS[(x >> 16) & 15] + " ")
            parts = list.push(parts, w)
            total = total + bytes.len(w)
    bytes.slice(bytes.concat(parts), 0, n)

fn gen_random(n: Int, seed: Int) -> Bytes
    var x = seed
    var out = [] as [Int]
    for _ in 0..n
        x = step_lcg(x)
        out = list.push(out, (x >> 16) & 255)
    bytes.from_byte_list(out)

fn html() -> Bytes
    bytes.from_str("<!DOCTYPE html><html><head><title>International development report</title></head><body><p>The government said the information was published on the internet; however, the international community was not satisfied with the report and the development of the programme.</p></body></html>")

fn concat3(a: Bytes, b: Bytes, c: Bytes) -> Bytes
    bytes.concat([a, b, c])

fn unhex(h: Str) -> Bytes
    bytes.from_hex(h) ?? bytes.zeros(0)

fn v_text_q5() -> Bytes
    unhex("")

fn w_text_q5() -> Bytes
    gen_text(3000, 1)

fn v_text_q11() -> Bytes
    unhex("")

fn w_text_q11() -> Bytes
    gen_text(6000, 2)

fn v_mixed_q11() -> Bytes
    unhex("")

fn w_mixed_q11() -> Bytes
    gen_mixed(9000, 3)

fn v_random_q5() -> Bytes
    unhex("")

fn w_random_q5() -> Bytes
    gen_random(400, 4)

fn v_html_q11() -> Bytes
    unhex("1b1a01408d94a9eb136cc0b164d8fab70fc84e5a3d59c8dd9842b52ea5bba454bacdeb75a82826836a2b203587a28909a2a3b8e05e013a7c70db8870a9e8714eae5a754d9ead7e24550fdbc82ffb79a61fe345f5e1c4ed2874a599a2af815406")

fn w_html_q11() -> Bytes
    html()

fn v_stream_pieces() -> Bytes
    unhex("")

fn w_stream_pieces() -> Bytes
    concat3(gen_text(900, 5), gen_mixed(700, 6), gen_text(1200, 7))

fn v_text_q1() -> Bytes
    unhex("")

fn w_text_q1() -> Bytes
    gen_text(2000, 8)

fn v_text_q0() -> Bytes
    unhex("")

fn w_text_q0() -> Bytes
    gen_text(1500, 9)

fn v_small_window() -> Bytes
    unhex("")

fn w_small_window() -> Bytes
    gen_text(5000, 10)

fn v_empty() -> Bytes
    unhex("06")

fn w_empty() -> Bytes
    bytes.zeros(0)

// The streams with the input each decodes to.
fn all_streams() -> [Bytes]
    [v_text_q5(),
        v_text_q11(),
        v_mixed_q11(),
        v_random_q5(),
        v_html_q11(),
        v_stream_pieces(),
        v_text_q1(),
        v_text_q0(),
        v_small_window(),
        v_empty()]

fn all_inputs() -> [Bytes]
    [w_text_q5(),
        w_text_q11(),
        w_mixed_q11(),
        w_random_q5(),
        w_html_q11(),
        w_stream_pieces(),
        w_text_q1(),
        w_text_q0(),
        w_small_window(),
        w_empty()]

fn names() -> [Str]
    ["text_q5",
        "text_q11",
        "mixed_q11",
        "random_q5",
        "html_q11",
        "stream_pieces",
        "text_q1",
        "text_q0",
        "small_window",
        "empty"]

fn roomy() -> BroLimits
    BroLimits { max_window: 16777200, max_output: 0 }

// Decode a stream by feeding `feed_size` bytes at a time into an output
// buffer of `out_size` bytes, and answer what came out or the reason it
// did not.
fn stream_decode(src: Bytes, feed_size: Int, out_size: Int) -> Result<Bytes, Str>
    match brotlidec.decoder(bytes.zeros(0), roomy())
        Err(e) => Err(e.message())
        Ok(d0) =>
            var d = d0
            var out = bytes.zeros(out_size)
            var got = [] as [Bytes]
            var fed = 0
            var going = true
            var why = ""
            while going
                match brotlidec.step(var d, var out, 0)
                    BroProduced(n) =>
                        got = list.push(got, bytes.slice(out, 0, n))
                    BroDone        =>
                        going = false
                    BroWantsDrain  =>
                        going = false
                        why = "drain"
                    BroNeedMore    =>
                        if fed >= bytes.len(src)
                            going = false
                            why = "starved"
                        else
                            let k = if fed + feed_size > bytes.len(src)
                                bytes.len(src) - fed
                            else
                                feed_size
                            match brotlidec.feed(var d, bytes.slice(src, fed, fed + k))
                                Ok(_)  =>
                                    fed = fed + k
                                Err(e) =>
                                    going = false
                                    why = e.message()
            match brotlidec.fault_of(d)
                Some(f) => Err(f.message())
                None    =>
                    if why == ""
                        Ok(bytes.concat(got))
                    else
                        Err(why)

@test
fn test_every_reference_stream_decodes_to_its_input() [io]
    let streams = all_streams()
    let inputs = all_inputs()
    let ns = names()
    for i in 0..list.len(streams)
        test.case("${ns[i]} in one call")
        match brotlidec.decompress(streams[i], roomy())
            Ok(b)  => test.assert(b == inputs[i])
            Err(e) => test.fail(e.message())

        test.case("${ns[i]}: the size can be had without keeping the bytes")
        match brotlidec.decompressed_size(streams[i], roomy())
            Ok(n)  => test.assert_eq(n, bytes.len(inputs[i]))
            Err(e) => test.fail(e.message())

@test
fn test_the_stream_decoder_gives_the_same_bytes_however_it_is_fed() [io]
    let streams = all_streams()
    let inputs = all_inputs()
    let ns = names()
    for i in 0..list.len(streams)
        for cfg in [[1, 1], [3, 7], [64, 100], [1000000, 65536]]
            test.case("${ns[i]} fed ${cfg[0]} at a time into ${cfg[1]} bytes")
            match stream_decode(streams[i], cfg[0], cfg[1])
                Ok(b)  => test.assert(b == inputs[i])
                Err(e) => test.fail(e)

@test
fn test_a_truncated_stream_is_refused_at_every_length() [io]
    let streams = all_streams()
    let ns = names()
    for i in 0..list.len(streams)
        let s = streams[i]
        test.case("${ns[i]} cut short")
        var wrong = 0
        var refused = 0
        var tried = 0
        let step = if bytes.len(s) > 300
            37
        else
            1
        var cut = 0
        while cut < bytes.len(s)
            tried = tried + 1
            match brotlidec.decompress(bytes.slice(s, 0, cut), roomy())
                Ok(_)  =>
                    wrong = wrong + 1
                Err(_) =>
                    refused = refused + 1
            cut = cut + step
        test.assert_eq(wrong, 0)
        test.assert_eq(refused, tried)

@test
fn test_a_damaged_stream_is_decoded_or_refused_and_never_runs_away() [io]
    let streams = all_streams()
    let ns = names()
    let limits = BroLimits { max_window: 16777200, max_output: 200000 }
    for i in 0..list.len(streams)
        test.case("${ns[i]} with one byte changed at a time")
        let s = streams[i]
        var survived = 0
        var refused = 0
        var at = 0
        let stride = if bytes.len(s) > 400
            23
        else
            1
        while at < bytes.len(s)
            for flip in [1, 128, 255]
                var t = bytes.clone(s)
                bytes.set_u8(t, at, (bytes.byte_at(t, at) ?? 0) ^ flip)
                match brotlidec.decompress(t, limits)
                    Ok(_)  =>
                        survived = survived + 1
                    Err(_) =>
                        refused = refused + 1
            at = at + stride
        test.assert(survived + refused > 0)

@test
fn test_a_budget_is_a_refusal_and_not_a_crash() [io]
    test.case("an output bound below the stream's size stops it at the byte it crossed")
    let tight = BroLimits { max_window: 16777200, max_output: 1000 }
    match brotlidec.decompress(v_text_q5(), tight)
        Ok(_)  => test.fail("3000 bytes came out of a 1000 byte budget")
        Err(e) =>
            test.assert(brotlierror.is_budget(e))
            test.assert(e.message() != "")

    test.case("and so does asking only for the size")
    match brotlidec.decompressed_size(v_text_q5(), tight)
        Ok(_)  => test.fail("3000 bytes came out of a 1000 byte budget")
        Err(e) => test.assert(brotlierror.is_budget(e))

    test.case("a window past the budget is refused before any memory is spent")
    let small = BroLimits { max_window: 4096, max_output: 0 }
    match brotlidec.decoder(v_text_q11(), small)
        Ok(_)  => test.fail("the stream wants a 4 MiB window")
        Err(e) =>
            match e
                BroWindowTooLarge(want, limit) =>
                    test.assert_eq(want, 4194288)
                    test.assert_eq(limit, 4096)
                _                              => test.fail("the refusal names the window")

    test.case("a failed decoder says so, answers Done, and refuses more input")
    match brotlidec.decoder(bytes.zeros(0), roomy())
        Err(_) => test.fail("an empty head is not an error")
        Ok(d0) =>
            var d = d0
            // A 16-bit window, then a metadata meta-block whose reserved bit is set.
            let bad = bytes.from_byte_list([28, 0, 0, 0])
            match brotlidec.feed(var d, bad)
                Ok(_)  => test.assert(not brotlidec.is_failed(d))
                Err(_) => test.fail("the fault is found by the step, not the feed")
            var out = bytes.zeros(16)
            match brotlidec.step(var d, var out, 0)
                BroDone => test.assert(brotlidec.is_failed(d))
                _       => test.fail("a failed decoder answers Done")
            match brotlidec.fault_of(d)
                Some(f) => test.assert_eq(f.message(), "brotli: the meta-block header at byte 0 has a bad reserved bit")
                None    => test.fail("the fault is kept")
            match brotlidec.feed(var d, bad)
                Ok(_)  => test.fail("a failed decoder takes no more input")
                Err(f) => test.assert(f.message() != "")
